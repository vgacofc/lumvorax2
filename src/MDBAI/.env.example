# MDBAI — Variables d'environnement (exemple)
# ⚠️ JAMAIS committer ce fichier avec de vraies valeurs !
# Utiliser Replit Secrets pour stocker les valeurs réelles.
# Conforme STANDARD_NAMES_MDBAI.md Section 2
# Conforme TOKEN_CLE_PLATFORME.txt PROTOCOLE: tokens révoqués = à re-générer

# ── Application ───────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
LOG_LEVEL=debug

# ── Session (générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=CHANGER_CET_VALEUR_32_CHARS_MIN

# ── Telegram Bot (@masterdebugai_bot) ─────────────────────────────────────
# Obtenir depuis @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=8820756284:REMPLACER_PAR_NOUVEAU_TOKEN

# ── Redis Cloud (redis-17068.c327.europe-west1-2.gce.cloud.redislabs.com) ─
