# ═══════════════════════════════════════════════════════════════════════════
# MAKEFILE C223 - Compilation Gen9 Native (0% OpenCL)
# ═══════════════════════════════════════════════════════════════════════════
# Migration vers Gen9 Native i915 DRM
# OBJECTIF : Éliminer dépendance OpenCL complètement
# Performance cible : 3,386 MH/s (baseline C198 Phase 12H)

CC = gcc
CFLAGS = -Wall -Wextra -O3 -march=native -pthread \
         -I. -Isrc -Iinclude -I../../../include \
         -I../../../src \
         -I../../../src/optimization \
         -I../../../src/debug \
         -I../../../src/advanced_calculations/quantum_problem_hubbard_hts/lumvorax \
         -I../../../src/advanced_calculations/quantum_problem_hubbard_hts_work/include \
         -Ilevel_zero_native/include \
         -I/usr/include/libdrm
LDFLAGS = -lm -lpthread -ldrm

# Répertoires
SRC_DIR = src
LEVEL_ZERO_NATIVE_DIR = level_zero_native
GEN9_SRC_DIR = $(LEVEL_ZERO_NATIVE_DIR)/src
GEN9_INC_DIR = $(LEVEL_ZERO_NATIVE_DIR)/include
LOG_DIR = logs
BIN_DIR = bin

# Fichiers sources Gen9 Native
GEN9_NATIVE_SRCS = $(GEN9_SRC_DIR)/btc_gen9_native_runner.c

# Fichiers sources programme minimal test
MINIMAL_TEST_SRCS = $(SRC_DIR)/main_btc_mining_gen9_minimal.c

# Fichiers sources moteur Bitcoin (non utilisés pour test minimal)
ENGINE_SRCS = $(SRC_DIR)/btc_mining_engine.c \
              $(SRC_DIR)/sha256_lumvorax.c \
              $(SRC_DIR)/nx48_btc_controller.c

# Binaire
BTC_MINING_BIN = $(BIN_DIR)/btc_mining_runner_gen9_native

# ═══════════════════════════════════════════════════════════════════════════
# RÈGLES
# ═══════════════════════════════════════════════════════════════════════════

.PHONY: all clean test run logs check-deps

all: $(BTC_MINING_BIN)

# Créer répertoires
$(BIN_DIR):
	mkdir -p $(BIN_DIR)

$(LOG_DIR):
	mkdir -p $(LOG_DIR)
	mkdir -p $(LOG_DIR)/forensic

# Vérifier dépendances
check-deps:
	@echo "═══════════════════════════════════════════════════════════════════════════"
	@echo "VÉRIFICATION DÉPENDANCES C223 - Gen9 Native"
	@echo "═══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "[C223-CHECK] Vérification /dev/dri/renderD128..."
	@ls -la /dev/dri/renderD128 2>/dev/null || echo "❌ /dev/dri/renderD128 non trouvé"
	@echo ""
	@echo "[C223-CHECK] Vérification libdrm..."
	@ldconfig -p | grep libdrm || echo "❌ libdrm non trouvé"
	@echo ""
	@echo "[C223-CHECK] Vérification bytecode Gen9..."
	@ls -lh $(LEVEL_ZERO_NATIVE_DIR)/btc_sha256_opt.bin.bin 2>/dev/null || echo "❌ Bytecode non trouvé"
	@echo ""
	@echo "[C223-CHECK] Vérification 0% OpenCL..."
	@echo "  Dépendances OpenCL détectées:"
	@ldconfig -p | grep -i opencl || echo "  ✅ Aucune dépendance OpenCL (objectif atteint)"
	@echo ""
	@echo "═══════════════════════════════════════════════════════════════════════════"

# Compiler programme minimal test Gen9 Native
$(BTC_MINING_BIN): $(MINIMAL_TEST_SRCS) $(GEN9_NATIVE_SRCS) | $(BIN_DIR) $(LOG_DIR)
	@echo "═══════════════════════════════════════════════════════════════════════════"
	@echo "COMPILATION C223 - Gen9 Native (0% OpenCL)"
	@echo "═══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "[C223-COMPILE] Architecture: Application → i915 DRM → GPU Gen9"
	@echo "[C223-COMPILE] Dépendances: libdrm (DRM standard Linux)"
	@echo "[C223-COMPILE] OpenCL: 0% (objectif atteint)"
	@echo ""
	@echo "[C223-COMPILE] Sources Gen9 Native:"
	@echo "  - $(GEN9_NATIVE_SRCS)"
	@echo ""
	@echo "[C223-COMPILE] Programme minimal test:"
	@echo "  - $(MINIMAL_TEST_SRCS)"
	@echo ""
	@echo "[C223-COMPILE] Compilation en cours..."
	$(CC) $(CFLAGS) \
		$(MINIMAL_TEST_SRCS) \
		$(GEN9_NATIVE_SRCS) \
		$(LDFLAGS) \
		-o $(BTC_MINING_BIN)
	@echo ""
	@echo "[C223-COMPILE] ✅ Compilation réussie: $(BTC_MINING_BIN)"
	@echo ""
	@echo "[C223-COMPILE] Vérification dépendances binaire:"
	@ldd $(BTC_MINING_BIN) | grep -i opencl && echo "  ❌ ERREUR: OpenCL détecté!" || echo "  ✅ 0% OpenCL confirmé"
	@echo ""
	@echo "═══════════════════════════════════════════════════════════════════════════"

# Lancer test 60 secondes
test: $(BTC_MINING_BIN)
	@echo ""
	@echo "═══════════════════════════════════════════════════════════════════════════"
	@echo "TEST C223 - Gen9 Native Production (60s)"
	@echo "═══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "[C223-TEST] Durée: 60 secondes"
	@echo "[C223-TEST] Batch size: 2,621,440 nonces (2.6M)"
	@echo "[C223-TEST] Cible hashrate: ≥ 3,386 MH/s"
	@echo "[C223-TEST] Logs: $(LOG_DIR)/forensic/gen9_native_production.log"
	@echo ""
	$(BTC_MINING_BIN) --duration 60 2>&1 | tee $(LOG_DIR)/test_gen9_native_c223.log
	@echo ""
	@echo "═══════════════════════════════════════════════════════════════════════════"
	@echo "TEST TERMINÉ"
	@echo "═══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "Logs disponibles:"
	@echo "  - $(LOG_DIR)/test_gen9_native_c223.log (sortie complète)"
	@echo "  - $(LOG_DIR)/forensic/gen9_native_production.log (logs bit-level)"
	@echo ""

# Lancer test 180 secondes (validation finale)
test-long: $(BTC_MINING_BIN)
	@echo ""
	@echo "═══════════════════════════════════════════════════════════════════════════"
	@echo "TEST LONG C223 - Gen9 Native (180s)"
	@echo "═══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "[C223-TEST] Durée: 180 secondes (validation finale)"
	@echo "[C223-TEST] Batch size: 2,621,440 nonces"
	@echo "[C223-TEST] Cible hashrate: ≥ 3,386 MH/s"
	@echo "[C223-TEST] Stabilité cible: ±0.2%"
	@echo ""
	$(BTC_MINING_BIN) --duration 180 2>&1 | tee $(LOG_DIR)/test_gen9_native_c223_long.log
	@echo ""
	@echo "═══════════════════════════════════════════════════════════════════════════"

# Nettoyer
clean:
	@echo "[C223-CLEAN] Nettoyage binaires et logs..."
	rm -rf $(BIN_DIR) $(LOG_DIR)
	@echo "[C223-CLEAN] ✅ Nettoyage terminé"

# Afficher aide
help:
	@echo "═══════════════════════════════════════════════════════════════════════════"
	@echo "MAKEFILE C223 - Gen9 Native (0% OpenCL)"
	@echo "═══════════════════════════════════════════════════════════════════════════"
	@echo ""
	@echo "Cibles disponibles:"
	@echo "  make check-deps  - Vérifier dépendances système"
	@echo "  make all         - Compiler moteur Bitcoin Gen9 Native"
	@echo "  make test        - Test 60 secondes (cible: 3,386 MH/s)"
	@echo "  make test-long   - Test 180 secondes (validation finale)"
	@echo "  make clean       - Nettoyer binaires et logs"
	@echo "  make help        - Afficher cette aide"
	@echo ""
	@echo "Objectif C223:"
	@echo "  ✅ 0% dépendance OpenCL"
	@echo "  ✅ Performance ≥ 3,386 MH/s"
	@echo "  ✅ Stabilité ±0.2%"
	@echo ""
	@echo "═══════════════════════════════════════════════════════════════════════════"

.DEFAULT_GOAL := help