---
version:         '1.49'
kernels:
  - name:            btc_sha256_mining_opt
    user_attributes:
      intel_reqd_workgroup_walk_order: [ 0, 1, 2 ]
      reqd_work_group_size: [ 64, 1, 1 ]
      vec_type_hint:   uint4
    execution_env:
      grf_count:       128
      required_work_group_size: [ 64, 1, 1 ]
      simd_size:       16
      private_size:    1280
      subgroup_independent_forward_progress: true
      eu_thread_count: 7
    payload_arguments:
      - arg_type:        global_id_offset
        offset:          0
        size:            12
      - arg_type:        local_size
        offset:          12
        size:            12
      - arg_type:        arg_bypointer
        offset:          0
        size:            0
        arg_index:       0
        addrmode:        stateful
        addrspace:       global
        access_type:     readonly
      - arg_type:        arg_bypointer
        offset:          32
        size:            8
        arg_index:       0
        addrmode:        stateless
        addrspace:       global
        access_type:     readonly
      - arg_type:        arg_bypointer
        offset:          0
        size:            0
        arg_index:       1
        addrmode:        stateful
        addrspace:       global
        access_type:     readonly
      - arg_type:        arg_bypointer
        offset:          40
        size:            8
        arg_index:       1
        addrmode:        stateless
        addrspace:       global
        access_type:     readonly
      - arg_type:        arg_bypointer
        offset:          0
        size:            0
        arg_index:       3
        addrmode:        stateful
        addrspace:       global
        access_type:     readwrite
      - arg_type:        buffer_address
        offset:          48
        size:            8
        arg_index:       3
      - arg_type:        arg_bypointer
        offset:          0
        size:            0
        arg_index:       4
        addrmode:        stateful
        addrspace:       global
        access_type:     readwrite
      - arg_type:        buffer_address
        offset:          56
        size:            8
        arg_index:       4
      - arg_type:        arg_byvalue
        offset:          64
        size:            4
        arg_index:       2
      - arg_type:        const_base
        offset:          72
        size:            8
        bti_value:       4
      - arg_type:        private_base_stateless
        offset:          80
        size:            8
      - arg_type:        enqueued_local_size
        offset:          96
        size:            12
    per_thread_payload_arguments:
      - arg_type:        local_id
        offset:          0
        size:            96
    binding_table_indices:
      - bti_value:       0
        arg_index:       0
      - bti_value:       1
        arg_index:       1
      - bti_value:       2
        arg_index:       3
      - bti_value:       3
        arg_index:       4
    per_thread_memory_buffers:
      - type:            scratch
        usage:           single_space
        size:            2048
  - name:            Intel_Symbol_Table_Void_Program
    execution_env:
      grf_count:       128
      has_no_stateless_write: true
      simd_size:       32
      subgroup_independent_forward_progress: true
      work_group_walk_order_dimensions: [ 0, 0, 0 ]
      eu_thread_count: 7
kernels_misc_info:
  - name:            btc_sha256_mining_opt
    args_info:
      - index:           0
        name:            block_header
        address_qualifier: __global
        access_qualifier: NONE
        type_name:       'uint*;8'
        type_qualifiers: const
      - index:           1
        name:            target
        address_qualifier: __global
        access_qualifier: NONE
        type_name:       'uint*;8'
        type_qualifiers: const
      - index:           2
        name:            nonce_start
        address_qualifier: __private
        access_qualifier: NONE
        type_name:       'uint;4'
        type_qualifiers: NONE
      - index:           3
        name:            results
        address_qualifier: __global
        access_qualifier: NONE
        type_name:       'uint*;8'
        type_qualifiers: NONE
      - index:           4
        name:            hashes
        address_qualifier: __global
        access_qualifier: NONE
        type_name:       'uint*;8'
        type_qualifiers: NONE
...
