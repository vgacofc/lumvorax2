  "code_examples": {
    "basic_setup": {
      "description": "Configuration de base avec API key",
      "code": [
        "import arc_agi",
        "from arc_agi import Arcade, OperationMode",
        "from arcengine import GameAction",
        "",
        "# Configuration avec clé API",
        "arc = Arcade(",
        "    arc_api_key='b6ebc9c5-a296-4578-be69-0cc16c9455d4',",
        "    operation_mode=OperationMode.COMPETITION",
        ")",
        "",
        "# Lister les jeux disponibles",
        "games = arc.get_environments()",
        "for game in games:",
        "    print(f'{game.game_id}: {game.title}')"
      ]
    },
    
    "play_game": {
      "description": "Jouer un jeu avec actions",
      "code": [
        "# Créer environnement",
        "env = arc.make('ls20', seed=0, save_recording=True)",
        "",
        "# Prendre des actions simples",
        "obs = env.step(GameAction.ACTION1)",
        "",
        "# Action complexe avec coordonnées",
        "obs = env.step(",
        "    GameAction.ACTION6,",
        "    data={'x': 32, 'y': 32},",
        "    reasoning={'thought': 'clicking center'}",
        ")",
        "",
        "# Vérifier état du jeu",
        "if obs:",
        "    print(f'State: {obs.state}')",
        "    print(f'Score: {obs.score}')",
        "    print(f'Levels completed: {obs.levels_completed}')"
      ]
    },
    
    "scorecard_management": {
      "description": "Gestion des scorecards",
      "code": [
        "# Créer scorecard personnalisé",
        "scorecard_id = arc.create_scorecard(",
        "    source_url='https://github.com/my/repo',",
        "    tags=['magen', 'v38', 'competition']",
        ")",
        "",
        "# Utiliser scorecard",
        "env = arc.make('ls20', scorecard_id=scorecard_id)",
        "",
        "# Fermer et obtenir résultats finaux",
        "final_scorecard = arc.close_scorecard(scorecard_id)",
        "if final_scorecard:",
        "    print(f'Final score: {final_scorecard.score}')",
        "    print(final_scorecard.model_dump_json(indent=2))"
      ]
    },
    
    "forensic_logging": {
      "description": "Logging forensique LumVorax intégré",
      "code": [
        "import json",
        "from datetime import datetime",
        "",
        "# Renderer personnalisé pour logging forensique",
        "def forensic_renderer(step: int, frame_data):",
        "    log_entry = {",
        "        'timestamp': datetime.utcnow().isoformat(),",
        "        'step': step,",
        "        'state': frame_data.state.name,",
        "        'score': frame_data.score,",
        "        'levels_completed': frame_data.levels_completed,",
        "        'frame_data': frame_data.model_dump()",
        "    }",
        "    with open('forensic_arc_agi.jsonl', 'a') as f:",
        "        f.write(json.dumps(log_entry) + '\\n')",
        "",
        "# Utiliser renderer",
        "env = arc.make('ls20', renderer=forensic_renderer)"
      ]
    }
  },
  
