@dataclass
class Metrics:
    active_energy: float
    archive_density: float
    invariant_count: int
    identity_stability: float
    causal_persistence: float
    replay_strength: float
    reconstruction_integrity: float
    accessibility_depth: float

class Gen8PersistentMemory:

    def __init__(self, size=64):

        self.size = size

        self.active = np.zeros((size,size))
        self.context = np.zeros((size,size))

        self.archive = []

        self.invariants = {}

        self.accessibility = np.ones((size,size))

        self.causal = np.zeros((size,size))

        self.identity = np.zeros((size,size))

        self.reconstructive_links = []

        self.activity_trace = []

    def inject_experience(self, x, y, v):

        self.active[x,y] += v

        experience = {
            "x": x,
            "y": y,
            "value": v,
            "time": len(self.archive)
        }

        self.archive.append(experience)

    def propagate(self):

        p = self.active.copy()
        new = p.copy()

        for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:

            shifted = np.roll(np.roll(p,dx,axis=0),dy,axis=1)

            new += shifted * 0.04

        overload = np.abs(new) > 50

        new[overload] *= 0.93

        self.active = new * 0.992

    def contextualize(self):

        self.context *= 0.998
        self.context += self.active * 0.003

    def semantic_invariant_extraction(self):

        observed = np.abs(self.active)

        red_zone = observed > 20
        blue_zone = (observed > 5) & (observed <= 20)
        weak_zone = observed <= 5

        self.invariants["HIGH_INTENSITY"] = int(np.sum(red_zone))
        self.invariants["MID_INTENSITY"] = int(np.sum(blue_zone))
        self.invariants["LOW_INTENSITY"] = int(np.sum(weak_zone))

    def resonance_consolidation(self):

        resonance = (
            np.abs(self.active)
            + np.abs(self.context)
            + self.causal
        )

        reinforce = resonance > 12

        self.causal[reinforce] += 0.003

        self.causal *= 0.9997

    def accessibility_gradients(self):

        stimulation = np.abs(self.active)

        self.accessibility *= 0.9995

        self.accessibility += stimulation * 0.0004

        self.accessibility = np.clip(
            self.accessibility,
            0.001,
            1.0
        )

    def autobiographical_persistence(self):

        self.identity = (
            self.identity * 0.9995
            + self.causal * 0.0005
            + self.context * 0.0002
        )

    def reconstructive_compression(self):

        if len(self.archive) < 2:
            return

        a = self.archive[-1]
        b = self.archive[-2]

        similarity = abs(a["value"] - b["value"])

        if similarity < 0.5:

            link = (
                a["time"],
                b["time"]
            )

            self.reconstructive_links.append(link)

    def causal_replay(self):

        if not self.reconstructive_links:
            return 0.0

        strength = 0

        recent = self.reconstructive_links[-50:]

        for a,b in recent:

            va = self.archive[a]["value"]
            vb = self.archive[b]["value"]

            replay = (va + vb) / 2

            strength += abs(replay)

        return strength / len(recent)

    def step(self):

        self.propagate()

        self.contextualize()

        self.semantic_invariant_extraction()

        self.resonance_consolidation()

        self.accessibility_gradients()

        self.autobiographical_persistence()

        self.reconstructive_compression()

        replay = self.causal_replay()

        self.activity_trace.append(
            np.mean(np.abs(self.active))
        )

        return replay

    def metrics(self, replay):

        archive_density = (
            len(self.archive)
            / (self.size * self.size)
        )

        invariant_count = len(self.invariants)

        identity_stability = np.mean(
            np.abs(self.identity)
        )

        causal_persistence = np.mean(
            self.causal
        )

        accessibility_depth = np.mean(
            self.accessibility
        )

        reconstruction_integrity = (
            len(self.reconstructive_links)
            / (1 + len(self.archive))
        )

        return Metrics(
            active_energy=float(
                np.mean(np.abs(self.active))
            ),
            archive_density=float(archive_density),
            invariant_count=int(invariant_count),
            identity_stability=float(identity_stability),
            causal_persistence=float(causal_persistence),
            replay_strength=float(replay),
            reconstruction_integrity=float(
                reconstruction_integrity
            ),
            accessibility_depth=float(
                accessibility_depth
            )
        )

