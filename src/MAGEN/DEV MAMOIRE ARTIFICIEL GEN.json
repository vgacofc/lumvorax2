            self.long_term.extend(migrated)

            self.mid_term = self.mid_term[50:]

    def propagate(self):

        p = self.active.copy()

        new = p.copy()

        for dx,dy in [

            (-1,0),
            (1,0),
            (0,-1),
            (0,1)

        ]:

            shifted = np.roll(
                np.roll(p,dx,axis=0),
                dy,
                axis=1
            )

            new += shifted * 0.03

        self.active = new * 0.997

    def replay_engine(self):

        if len(self.causal_sequences) < 5:
            return 0.0

        recent = self.causal_sequences[-50:]

        coherence = 0

        for a,b in recent:

            va = self.deep_archive[a]["magnitude"]
            vb = self.deep_archive[b]["magnitude"]

            delta = abs(va-vb)

            coherence += 1/(1+delta)

        return coherence / len(recent)

    def stabilize_identity(self):

        self.identity_field = (

            self.identity_field * 0.9999

            + self.active * 0.0002

            + self.context * 0.0001

        )

        self.identity_graph.append(
            np.mean(np.abs(self.identity_field))
        )

    def accessibility_gradients(self):

        stimulation = np.abs(self.active)

        self.accessibility *= 0.9998

        self.accessibility += (
            stimulation * 0.0001
        )

        self.accessibility = np.clip(
            self.accessibility,
            0.001,
            1.0
        )

    def step(self):

        self.propagate()

        self.memory_consolidation()

        self.stabilize_identity()

        self.accessibility_gradients()

        replay = self.replay_engine()

        return replay

