            "magnitude": abs(v)

        }

        # append-only persistence
        self.short_term.append(exp)
        self.deep_archive.append(exp)

        self.semantic_binding(exp)

        self.detect_contradictions(exp)

        self.build_causal_sequences(exp)

    def semantic_binding(self,exp):

        mag = exp["magnitude"]

        if mag > 150:
            label = "EXTREME"

        elif mag > 80:
            label = "HIGH"

        elif mag > 30:
            label = "MID"

        else:
            label = "LOW"

        if label not in self.semantic_relations:
            self.semantic_relations[label] = 0

        self.semantic_relations[label] += 1

        if self.semantic_relations[label] > 100:

            self.cross_context_invariants[label] = True

    def detect_contradictions(self,exp):

        if len(self.deep_archive) < 2:
            return

        prev = self.deep_archive[-2]

        delta = abs(
            prev["magnitude"]
            - exp["magnitude"]
        )

        if delta > 140:

            self.contradictions.append(
                (prev["time"],exp["time"])
            )

            self.contradiction_pressure += 1

    def build_causal_sequences(self,exp):

        if len(self.deep_archive) < 2:
            return

        prev = self.deep_archive[-2]

        seq = (
            prev["time"],
            exp["time"]
        )

        self.causal_sequences.append(seq)

