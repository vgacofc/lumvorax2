import json, time, hashlib, os, sys
from datetime import datetime, timezone
LOG_DIR = "/home/lvx/LVX/lumvorax2/logs/ubuntu"
os.makedirs(LOG_DIR, exist_ok=True)
def list_runs():
    if not os.path.isdir(LOG_DIR): return []
    return sorted([d for d in os.listdir(LOG_DIR) if os.path.isdir(os.path.join(LOG_DIR,d))])
runs = list_runs()
print(f"[C97.4] runs trouvés : {len(runs)}", flush=True)
for r in runs[-15:]:
    print(f"  {r}", flush=True)
def load_loss(run_dir):
    full = os.path.join(LOG_DIR, run_dir)
    nx48_log = os.path.join(full, "nx48_neural.log")
    if not os.path.exists(nx48_log): return None
    losses = []
    with open(nx48_log) as f:
        for line in f:
            if "loss=" in line:
                try:
                    v = float(line.split("loss=")[1].split()[0].replace(",",""))
                    losses.append(v)
                except: pass
    return losses
ab = {"cycle":"C97.4","started":datetime.now(timezone.utc).isoformat(),"runs":[]}
for r in runs:
    losses = load_loss(r)
    if losses:
        entry = {"run":r,"loss_init":losses[0],"loss_final":losses[-1],"steps":len(losses),
                 "delta_pct":round(100*(losses[-1]-losses[0])/losses[0],3)}
        ab["runs"].append(entry)
        print(f"[C97.4] {r}: init={losses[0]:.4f} final={losses[-1]:.4f} Δ={entry['delta_pct']}%", flush=True)
if ab["runs"]:
    ab["mean_delta_pct"] = round(sum(r["delta_pct"] for r in ab["runs"])/len(ab["runs"]),3)
    ab["best_delta_pct"] = min(r["delta_pct"] for r in ab["runs"])
    ab["worst_delta_pct"] = max(r["delta_pct"] for r in ab["runs"])
    print(f"[C97.4] AGRÉGÉ: mean Δ={ab['mean_delta_pct']}%  best={ab['best_delta_pct']}%  worst={ab['worst_delta_pct']}%", flush=True)
with open("/tmp/c97_4_nx48_ab.json","w") as f: json.dump(ab,f,indent=2)
print(json.dumps(ab,indent=2)[:2000])
